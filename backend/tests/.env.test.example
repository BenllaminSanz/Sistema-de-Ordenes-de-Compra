# Copiar a tests/.env.test si necesitas sobrescribir credenciales.
# Por defecto el runner reutiliza host/user/pass del .env del proyecto
# y fuerza DB_NAME=ordenes_compra_test.

NODE_ENV=test
SKIP_DB_EAGER_CHECK=1

JWT_SECRET=test_jwt_secret_min_32_chars_xxxxxx
JWT_EXPIRES_IN=1h
SECRET_ENCRYPTION_KEY=12345678901234567890123456789012

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
DB_NAME=ordenes_compra_test

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
