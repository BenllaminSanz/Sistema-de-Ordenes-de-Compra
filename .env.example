# ============================================================
# Sistema de Órdenes de Compra - Variables de Entorno
# ============================================================
# Copia este archivo como ".env" en la raíz del proyecto
# y completa los valores según tu entorno.
#
# IMPORTANTE: Nunca subas el archivo .env real al repositorio.
# ============================================================

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
PORT=3000
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------
# Base de Datos MySQL
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ordenes_compra

# ------------------------------------------------------------
# Autenticación (JWT)
# ------------------------------------------------------------
JWT_SECRET=tu_clave_secreta_muy_larga_y_segura_cambiar_en_produccion
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------
# Encriptación (usado en cryptoHelper)
# ------------------------------------------------------------
SECRET_ENCRYPTION_KEY=12345678901234567890123456789012   # Exactamente 32 caracteres

# ------------------------------------------------------------
# Correo Electrónico (SMTP)
# ------------------------------------------------------------
# NOTA: A partir de la versión con panel de admin, la configuración SMTP
#       se puede gestionar desde la interfaz (solo admin) en "Configuración SMTP".
#       Los valores de aquí actúan como FALLBACK cuando no hay configuración
#       activa en la tabla `configuracion_smtp` de la base de datos.
#
#       Recomendado: configurar vía UI de admin después de la primera instalación.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@empresa.com
EMAIL_PASS=tu_contraseña_o_token_de_aplicacion
EMAIL_SECURE=false
EMAIL_TLS_CIPHERS=SSLv3
EMAIL_REJECT_UNAUTHORIZED=false

# URL del frontend (usado para enlaces en correos)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------
# Usuario Administrador (para seed-admin.js)
# ------------------------------------------------------------
ADMIN_EMAIL=jebesari48@gmail.com
ADMIN_PASSWORD=Admin1234!          # Cambia esta contraseña después del primer login
ADMIN_NOMBRE=Benjamin Sanchez

# ------------------------------------------------------------
# Opcional / Futuro
# ------------------------------------------------------------
# NODE_ENV=development
