# ============================================================
# Sistema de Órdenes de Compra — Variables de Entorno
# Copiar a .env en la raíz del proyecto y completar los valores.
# ============================================================

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
PORT=3000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------
# Base de Datos MySQL
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ordenes_compra

# ------------------------------------------------------------
# Autenticación (JWT)
# ------------------------------------------------------------
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
# Alias soportado: JWT_EXPIRES (si no defines JWT_EXPIRES_IN)

# ------------------------------------------------------------
# Encriptación (32 caracteres — usada para SMTP en DB)
# ------------------------------------------------------------
SECRET_ENCRYPTION_KEY=cambiar_por_llave_de_32_caracteres

# ------------------------------------------------------------
# Correo Electrónico (SMTP — fallback si no hay config en DB)
# ------------------------------------------------------------
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_TLS_CIPHERS=SSLv3
EMAIL_REJECT_UNAUTHORIZED=false
EMAIL_CC_COTIZACIONES=

# ------------------------------------------------------------
# Usuario administrador inicial (script seed-admin.js)
# ------------------------------------------------------------
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=CambiarPassword123!
ADMIN_NOMBRE=Administrador